# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database
DATABASE_URL=sqlite:///./threatnex.db

# External APIs (optional — local detection works without these)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
PHISHTANK_API_KEY=

# Security
SECRET_KEY=change-this-to-a-random-secret
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
